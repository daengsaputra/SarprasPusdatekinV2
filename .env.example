APP_NAME="SarprasPusdatekinBPIP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://sarpras.localhost:9180

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=sarpras-bpip
DB_USERNAME=sarprasuser
DB_PASSWORD=rootnihbener@!444
DB_ROOT_PASSWORD=rootnihbener@!444r00tsarpras

# ===== CACHING & SESSION =====
SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_DRIVER=file
QUEUE_CONNECTION=sync

API_URL=http://sarpras.localhost:9180





# === BPIP SSO (OAuth2) ===
# Aktifkan/nonaktifkan SSO. Set false hanya jika benar-benar tidak butuh login.
SSO_ENABLED=true

# Kredensial OAuth2 dari tim SSO BPIP
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# Pastikan REDIRECT_URI cocok dengan yang terdaftar di SSO (mis: <APP_URL>/sso/callback)
SSO_REDIRECT_URI="${APP_URL}/sso/callback"

# Endpoint SSO BPIP (lihat .env sinergi sebagai referensi)
SSO_AUTHORIZATION_URL=
SSO_ACCESS_TOKEN_URL=
SSO_RESOURCE_OWNER_DETAILS_URL=

# Domain SSO untuk endpoint /logout (opsional, kosongkan utk skip)
SSO_DOMAIN=

# Endpoint API user detail (sumber pegawaiData & userData)
URL_API_BPIP=
# Endpoint API SIMPEG (untuk fitur search pegawai berikutnya)
URL_API_SIATAP_BPIP=

# Default role bagi user SSO yang TIDAK ada di sso_role_overrides.
# Pilihan: super_admin | petugas | peminjam
SSO_DEFAULT_ROLE=peminjam
